{
  "name": "web-specs-companion",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:sideshowbarker/web-specs-companion",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "snapshot": "node scripts/snapshot.ts",
    "icons": "node scripts/make-icons.ts",
    "package": "node scripts/package.ts",
    "mac-app": "npm run build && node scripts/mac-app.ts",
    "screenshots": "npm run build && node scripts/screenshots.ts",
    "site": "node scripts/site.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir dist",
    "e2e:firefox": "node e2e/firefox-bidi.ts"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@testing-library/preact": "3.2.4",
    "@types/chrome": "0.3.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.3",
    "marked": "18.0.14",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
